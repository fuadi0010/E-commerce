# ==============================================================================
# E-COMMERCE APPLICATION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# Petunjuk Penggunaan:
# 1. Salin file ini menjadi '.env' pada root project:
#    - Terminal / Bash: cp .env.example .env
#    - PowerShell: Copy-Item .env.example .env
# 2. Isi nilai rahasia (DB_PASSWORD, JWT_SECRET, dll.) sesuai environment lokal Anda.
# 3. JANGAN PERNAH meng-commit file '.env' ke Git repository!
# ==============================================================================

# ==========================================
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ==========================================
DB_URL=jdbc:postgresql://localhost:5432/ecommerce_db
DB_USERNAME=postgres
# Wajib diisi dengan password database PostgreSQL Anda
DB_PASSWORD=your_database_password_here

# ==========================================
# 2. SECURITY & JWT CONFIGURATION
# ==========================================
# Wajib diisi dengan string acak dengan entropi tinggi (minimal 256-bit / 32 karakter).
# Contoh pembuatan kunci di terminal:
# - Bash/OpenSSL: openssl rand -base64 32
# - PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 } | ForEach-Object { [byte]$_ }))
JWT_SECRET=your_secure_random_jwt_secret_minimum_256_bits_here

# Masa berlaku Access Token dalam milidetik (3600000 = 1 jam)
JWT_EXPIRATION_MS=3600000

# ==========================================
# 3. SERVER & FRONTEND URLS
# ==========================================
SERVER_PORT=8080
# Digunakan backend untuk merangkai tautan Reset Password pada email
FRONTEND_URL=http://localhost:4200

# ==========================================
# 4. EMAIL CONFIGURATION (Gmail SMTP)
# ==========================================
# Gunakan alamat Gmail Anda dan Google App Password (16 karakter tanpa spasi).
# Panduan pembuatan App Password:
# 1. Buka Akun Google -> Keamanan (Security)
# 2. Aktifkan Verifikasi 2 Langkah (2-Step Verification) jika belum aktif
# 3. Cari "Sandi Aplikasi" (App Passwords)
# 4. Buat sandi baru (misal: "E-Commerce Backend"), salin 16 karakter password ke MAIL_PASSWORD
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_16_character_google_app_password
MAIL_FROM=your_gmail_address@gmail.com
MAIL_FROM_NAME=E-Commerce App

# ==========================================
# 5. OTP CONFIGURATION (Verifikasi Registrasi Akun)
# ==========================================
OTP_EXPIRATION_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
