spring.application.name=backend

# ==========================================
# 0. ENVIRONMENT CONFIGURATION IMPORT (.env)
# ==========================================
spring.config.import=optional:file:../.env[.properties],optional:file:.env[.properties]

# ==========================================
# 1. SERVER & TIMEZONE
# ==========================================
server.port=${SERVER_PORT:8080}
# Memaksa Jackson (JSON serializer) menggunakan UTC saat mengirim tanggal ke Angular
spring.jackson.time-zone=UTC

# ==========================================
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ==========================================
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/ecommerce_db}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD:your_postgres_password}
spring.datasource.driver-class-name=org.postgresql.Driver

# ==========================================
# 3. CONNECTION POOLING (HikariCP)
# ==========================================
# Ini krusial untuk production. Mencegah server mati karena kehabisan koneksi.
spring.datasource.hikari.maximum-pool-size=20
spring.datasource.hikari.minimum-idle=5
spring.datasource.hikari.connection-timeout=20000
spring.datasource.hikari.idle-timeout=300000
spring.datasource.hikari.max-lifetime=1200000

# ==========================================
# 4. JPA / HIBERNATE SETTINGS
# ==========================================
# WAJIB 'validate' jika sudah pakai skema DDL manual/Flyway. 
# Gunakan 'update' HANYA di environment lokal jika Anda malas menulis SQL.
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
# Matikan show-sql di production karena akan membuat log server penuh (I/O bottleneck)
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=false
spring.jpa.open-in-view=false
# Rule 18 & Performance: Selesaikan masalah N+1 pada lazy loading (collections & proxies) secara batch
spring.jpa.properties.hibernate.default_batch_fetch_size=100

# ==========================================
# 5. MULTIPART / FILE UPLOAD (Syarat Dokumen)
# ==========================================
# Dokumen mewajibkan fitur upload Gambar atau PDF
# Batasi ukuran file untuk mencegah serangan Denial of Service (DoS) berupa file raksasa
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=5MB

# ==========================================
# 6. SECURITY & JWT (Custom Properties)
# ==========================================
# Jangan pernah hardcode secret key di file ini saat push ke GitHub!
app.jwt.secret=${JWT_SECRET:your_jwt_secret_key_minimum_256_bits_length}
app.jwt.expirationMs=${JWT_EXPIRATION_MS:3600000}

# ==========================================
# 7. EMAIL CONFIGURATION (Gmail SMTP)
# ==========================================
# Base URL Frontend (Digunakan untuk membuat Reset Password Link)
app.frontend.url=${FRONTEND_URL:http://localhost:4200}

# Spring Mail (Gmail SMTP)
spring.mail.host=${MAIL_HOST:smtp.gmail.com}
spring.mail.port=${MAIL_PORT:587}
spring.mail.username=${MAIL_USERNAME:your_gmail_address@gmail.com}
spring.mail.password=${MAIL_PASSWORD:your_google_app_password}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true
spring.mail.properties.mail.smtp.from=${MAIL_FROM:${spring.mail.username:your_gmail_address@gmail.com}}
spring.mail.default-encoding=UTF-8

# App Email Properties
app.mail.from-name=${MAIL_FROM_NAME:E-Commerce App}

# ==========================================
# 8. OTP CONFIGURATION (Account Registration)
# ==========================================
app.otp.expiration-minutes=${OTP_EXPIRATION_MINUTES:5}
app.otp.max-attempts=${OTP_MAX_ATTEMPTS:5}
app.otp.resend-cooldown-seconds=${OTP_RESEND_COOLDOWN_SECONDS:60}