spring.application.name=backend

# ==========================================
# 1. SERVER & TIMEZONE
# ==========================================
server.port=8080
# Memaksa Jackson (JSON serializer) menggunakan UTC saat mengirim tanggal ke Angular
spring.jackson.time-zone=UTC

# ==========================================
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ==========================================
spring.datasource.url=jdbc:postgresql://localhost:5432/ecommerce_db
# Asumsi: Anda menggunakan environment variables di server asli, jangan hardcode di Git!
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD:secret}
spring.datasource.driver-class-name=org.postgresql.Driver

# ==========================================
# 3. CONNECTION POOLING (HikariCP)
# ==========================================
# Ini krusial untuk production. Mencegah server mati karena kehabisan koneksi.
spring.datasource.hikari.maximum-pool-size=20
spring.datasource.hikari.minimum-idle=5
spring.datasource.hikari.connection-timeout=20000
spring.datasource.hikari.idle-timeout=300000
spring.datasource.hikari.max-lifetime=1200000

# ==========================================
# 4. JPA / HIBERNATE SETTINGS
# ==========================================
# WAJIB 'validate' jika sudah pakai skema DDL manual/Flyway. 
# Gunakan 'update' HANYA di environment lokal jika Anda malas menulis SQL.
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
# Matikan show-sql di production karena akan membuat log server penuh (I/O bottleneck)
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=false
spring.jpa.open-in-view=false

# ==========================================
# 5. MULTIPART / FILE UPLOAD (Syarat Dokumen)
# ==========================================
# Dokumen mewajibkan fitur upload Gambar atau PDF
# Batasi ukuran file untuk mencegah serangan Denial of Service (DoS) berupa file raksasa
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=5MB

# ==========================================
# 6. SECURITY & JWT (Custom Properties)
# ==========================================
# Jangan pernah hardcode secret key di file ini saat push ke GitHub!
app.jwt.secret=${JWT_SECRET:rahasia-default-yang-sangat-panjang-minimal-256-bit-untuk-hs256}
app.jwt.expirationMs=3600000

# ==========================================
# 7. EMAIL CONFIGURATION (Mailtrap)
# ==========================================
spring.mail.host=${MAIL_HOST:sandbox.smtp.mailtrap.io}
spring.mail.port=${MAIL_PORT:2525}
spring.mail.username=${MAIL_USERNAME:your_mailtrap_username}
spring.mail.password=${MAIL_PASSWORD:your_mailtrap_password}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true